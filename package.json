{
  "name": "@veridex/sdk",
  "version": "1.0.0",
  "description": "Veridex Protocol SDK - Client library for Passkey-based cross-chain authentication",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./wormhole": {
      "import": "./dist/wormhole.mjs",
      "require": "./dist/wormhole.js",
      "types": "./dist/wormhole.d.ts"
    },
    "./payload": {
      "import": "./dist/payload.mjs",
      "require": "./dist/payload.js",
      "types": "./dist/payload.d.ts"
    },
    "./utils": {
      "import": "./dist/utils.mjs",
      "require": "./dist/utils.js",
      "types": "./dist/utils.d.ts"
    },
    "./constants": {
      "import": "./dist/constants.mjs",
      "require": "./dist/constants.js",
      "types": "./dist/constants.d.ts"
    },
    "./types": {
      "import": "./dist/types.mjs",
      "require": "./dist/types.js",
      "types": "./dist/types.d.ts"
    },
    "./chains/evm": {
      "import": "./dist/chains/evm/index.mjs",
      "require": "./dist/chains/evm/index.js",
      "types": "./dist/chains/evm/index.d.ts"
    },
    "./chains/solana": {
      "import": "./dist/chains/solana/index.mjs",
      "require": "./dist/chains/solana/index.js",
      "types": "./dist/chains/solana/index.d.ts"
    },
    "./chains/aptos": {
      "import": "./dist/chains/aptos/index.mjs",
      "require": "./dist/chains/aptos/index.js",
      "types": "./dist/chains/aptos/index.d.ts"
    },
    "./chains/sui": {
      "import": "./dist/chains/sui/index.mjs",
      "require": "./dist/chains/sui/index.js",
      "types": "./dist/chains/sui/index.d.ts"
    },
    "./chains/starknet": {
      "import": "./dist/chains/starknet/index.mjs",
      "require": "./dist/chains/starknet/index.js",
      "types": "./dist/chains/starknet/index.d.ts"
    },
    "./queries": {
      "import": "./dist/queries/index.mjs",
      "require": "./dist/queries/index.js",
      "types": "./dist/queries/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write src/**/*.ts"
  },
  "dependencies": {
    "@simplewebauthn/browser": "^9.0.1",
    "@solana/spl-token": "^0.4.6",
    "@solana/web3.js": "^1.95.4",
    "@wormhole-foundation/sdk": "^0.10.0",
    "@wormhole-foundation/wormhole-query-sdk": "^0.0.14",
    "axios": "^1.7.9",
    "aptos": "^1.21.0",
    "ethers": "^6.11.1",
    "@mysten/sui": "^1.0.0",
    "starknet": "^6.12.0"
  },
  "devDependencies": {
    "@simplewebauthn/types": "^9.0.1",
    "@types/node": "^20.11.24",
    "tsup": "^8.0.2",
    "typescript": "^5.3.3",
    "vitest": "^1.3.1"
  },
  "peerDependencies": {
    "ethers": ">=6.0.0"
  },
  "peerDependenciesMeta": {
    "ethers": {
      "optional": false
    }
  },
  "keywords": [
    "veridex",
    "cross-chain",
    "wormhole",
    "passkey",
    "webauthn",
    "ethereum",
    "solana",
    "aptos",
    "sui"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Veridex-Protocol/demo"
  }
}