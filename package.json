{
  "name": "@veridex/sdk",
  "version": "1.1.3",
  "description": "Veridex Protocol SDK - Client library for Passkey-based cross-chain authentication",
  "author": "Veridex Protocol <team@veridex.network>",
  "license": "MIT",
  "homepage": "https://veridex.network",
  "bugs": {
    "url": "https://github.com/Veridex-Protocol/sdk/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Veridex-Protocol/sdk.git"
  },
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist",
    "scripts",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./wormhole": {
      "types": "./dist/wormhole.d.ts",
      "import": "./dist/wormhole.mjs",
      "require": "./dist/wormhole.js"
    },
    "./payload": {
      "types": "./dist/payload.d.ts",
      "import": "./dist/payload.mjs",
      "require": "./dist/payload.js"
    },
    "./utils": {
      "types": "./dist/utils.d.ts",
      "import": "./dist/utils.mjs",
      "require": "./dist/utils.js"
    },
    "./constants": {
      "types": "./dist/constants.d.ts",
      "import": "./dist/constants.mjs",
      "require": "./dist/constants.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.mjs",
      "require": "./dist/types.js"
    },
    "./chains/evm": {
      "types": "./dist/chains/evm/index.d.ts",
      "import": "./dist/chains/evm/index.mjs",
      "require": "./dist/chains/evm/index.js"
    },
    "./chains/solana": {
      "types": "./dist/chains/solana/index.d.ts",
      "import": "./dist/chains/solana/index.mjs",
      "require": "./dist/chains/solana/index.js"
    },
    "./chains/aptos": {
      "types": "./dist/chains/aptos/index.d.ts",
      "import": "./dist/chains/aptos/index.mjs",
      "require": "./dist/chains/aptos/index.js"
    },
    "./chains/sui": {
      "types": "./dist/chains/sui/index.d.ts",
      "import": "./dist/chains/sui/index.mjs",
      "require": "./dist/chains/sui/index.js"
    },
    "./chains/starknet": {
      "types": "./dist/chains/starknet/index.d.ts",
      "import": "./dist/chains/starknet/index.mjs",
      "require": "./dist/chains/starknet/index.js"
    },
    "./chains/stacks": {
      "types": "./dist/chains/stacks/index.d.ts",
      "import": "./dist/chains/stacks/index.mjs",
      "require": "./dist/chains/stacks/index.js"
    },
    "./chains/avalanche": {
      "types": "./dist/chains/avalanche/index.d.ts",
      "import": "./dist/chains/avalanche/index.mjs",
      "require": "./dist/chains/avalanche/index.js"
    },
    "./chains/stellar": {
      "types": "./dist/chains/stellar/index.d.ts",
      "import": "./dist/chains/stellar/index.mjs",
      "require": "./dist/chains/stellar/index.js"
    },
    "./passkey": {
      "types": "./dist/passkey.d.ts",
      "import": "./dist/passkey.mjs",
      "require": "./dist/passkey.js"
    },
    "./queries": {
      "types": "./dist/queries/index.d.ts",
      "import": "./dist/queries/index.mjs",
      "require": "./dist/queries/index.js"
    },
    "./auth": {
      "types": "./dist/auth/prepareAuth.d.ts",
      "import": "./dist/auth/prepareAuth.mjs",
      "require": "./dist/auth/prepareAuth.js"
    }
  },
  "scripts": {
    "postinstall": "node scripts/patch-noble-curves.js",
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write src/**/*.ts",
    "prepublishOnly": "bun run build",
    "release:public": "cd ../.. && git subtree push --prefix=packages/sdk sdk-public main"
  },
  "dependencies": {
    "@aptos-labs/ts-sdk": "^6.0.0",
    "@noble/curves": "^1.9.0",
    "@mysten/bcs": "1.9.2",
    "@mysten/sui": "^1.0.0",
    "@noble/hashes": "^1.5.0",
    "@simplewebauthn/browser": "^9.0.1",
    "@solana/spl-token": "^0.4.6",
    "@solana/web3.js": "^1.95.4",
    "@wormhole-foundation/sdk": "^0.10.0",
    "@wormhole-foundation/wormhole-query-sdk": "^0.0.14",
    "axios": "^1.7.9",
    "ethers": "^6.11.1",
    "js-sha3": "^0.9.3",
    "starknet": "^6.12.0"
  },
  "devDependencies": {
    "@simplewebauthn/types": "^9.0.1",
    "@types/node": "^20.11.24",
    "@vitest/coverage-v8": "^1.3.1",
    "tsup": "^8.0.2",
    "typescript": "^5.3.3",
    "vitest": "^1.3.1"
  },
  "peerDependencies": {
    "ethers": ">=6.0.0"
  },
  "peerDependenciesMeta": {
    "ethers": {
      "optional": false
    }
  },
  "keywords": [
    "veridex",
    "cross-chain",
    "wormhole",
    "passkey",
    "webauthn",
    "ethereum",
    "stellar",
    "soroban",
    "solana",
    "aptos",
    "sui",
    "starknet",
    "stacks",
    "authentication",
    "gasless",
    "session-keys",
    "wallet-abstraction"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
